{{- $pages := where .Site.Pages "Kind" "in" (slice "page" "section") -}}
{{- $pages = where $pages "Params.bookSearchExclude" "!=" true -}}
{{- $pages = where $pages "Content" "!=" "" -}}
[
{{- range $index, $page := $pages -}}
  {{- if gt $index 0 }},{{ end -}}
  {
    "href": {{ $page.RelPermalink | jsonify }},
    "title": {{ (partial "docs/title" $page) | jsonify }},
    "section": {{ (partial "docs/title" $page.Parent) | default $.Site.Title | jsonify }},
    "content": {{ $page.Plain | jsonify }},
    "headings": [
      {{- range $hi, $h := $page.Fragments.Headings -}}
        {{- if gt $hi 0 }},{{ end -}}
        {"id":{{ $h.ID | jsonify }},"title":{{ $h.Title | jsonify }},"level":{{ $h.Level }}}
        {{- range $si, $sub := $h.Headings -}}
          ,{"id":{{ $sub.ID | jsonify }},"title":{{ $sub.Title | jsonify }},"level":{{ $sub.Level }}}
        {{- end -}}
      {{- end -}}
    ]
  }
{{- end -}}
]
